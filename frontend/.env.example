# API (optional; default /api/v1)
# VITE_API_BASE_URL=/api/v1

# Cloudflare R2 public CDN (required for site images/docs screenshots)
# VITE_STATIC_CDN=https://assets.cangyuansuanli.cn

# frontend/static-assets/ is upload source only (pnpm run upload:assets), not bundled into dist.
# Upload skips unchanged files (local MD5 vs R2 ETag). Use: pnpm run upload:assets -- --force

# R2 upload (frontend/.env.local — gitignored)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pro
# R2_PUBLIC_BASE_URL=https://assets.cangyuansuanli.cn
# VITE_STATIC_CDN=https://assets.cangyuansuanli.cn
